{
  "name": "@doyensec/electronegativity",
  "version": "2.0.0",
  "description": "Electronegativity is a tool to identify misconfigurations and security anti-patterns in Electron applications",
  "type": "module",
  "main": "src/runner.js",
  "exports": {
    ".": "./src/runner.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "electronegativity": "src/index.js"
  },
  "files": [
    "src/",
    "docs/*.json",
    "docs/*.md",
    "defaults.json",
    "safe_releases.json"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "mocha",
    "test:runtime": "mocha --no-config --timeout 150000 test/test_watch.js test/test_runtime_benchmark.js --forbid-pending",
    "test:windows-proofs": "mocha --no-config --timeout 120000 test/test_windows_proofs.js test/test_windows_live_proofs.js --forbid-pending",
    "test:benchmark": "node scripts/benchmark-known-vulnerabilities.mjs ../electron-benchmark/sources ../electron-benchmark/results-ci --download && node scripts/evaluate-known-vulnerabilities.mjs ../electron-benchmark/sources ../electron-benchmark/results-ci --ci",
    "check:references": "node scripts/check-references.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doyensec/electronegativity.git"
  },
  "author": "info@doyensec.com",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/doyensec/electronegativity/issues"
  },
  "homepage": "https://github.com/doyensec/electronegativity#readme",
  "dependencies": {
    "@babel/parser": "^8.0.6",
    "@babel/traverse": "^8.0.6",
    "@doyensec/csp-evaluator": "^1.0.3",
    "@electron/asar": "^4.3.0",
    "@typescript-eslint/typescript-estree": "^8.70.1",
    "@typescript-eslint/visitor-keys": "^8.70.1",
    "@yarnpkg/lockfile": "^1.1.0",
    "chalk": "^6.0.0",
    "cheerio": "^1.2.0",
    "cli-progress": "^3.12.0",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "eslint-scope": "^9.1.2",
    "eslint-visitor-keys": "^5.0.1",
    "espree": "^11.2.0",
    "estraverse": "^5.3.0",
    "i18n": "^0.15.4",
    "linenumber": "^1.0.1",
    "semver": "^7.8.5",
    "typescript": "~6.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "chai": "^6.2.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "mocha": "^12.0.2"
  },
  "keywords": [
    "electron",
    "security",
    "electron-security",
    "sast"
  ]
}
